REMOTE_HOST="REMOTE_SSH_ALIAS"
REMOTE_DIR="/REMOTE/PATH/ogprofiler-deploy"
REMOTE_RUNS_DIR="/REMOTE/PATH/ogprofiler-runs"
REMOTE_CONDA="/REMOTE/PATH/micromamba"
REMOTE_CONDA_ENV="ogprofiler"
REMOTE_TEST_CMD="pytest -q"
REMOTE_DIR_IS_DISPOSABLE=1
REQUIRE_CLEAN_FOR_SLURM=0
PUSH_EXCLUDES=(
  ".git/"
  ".provenance/"
  "dev/remote.env"
  ".venv/"
  "__pycache__/"
  ".pytest_cache/"
  ".mypy_cache/"
  ".ruff_cache/"
  "results/"
  "outputs/"
  "logs/"
)
