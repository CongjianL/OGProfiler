#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
CONFIG="$SCRIPT_DIR/remote.env"
[[ -f "$CONFIG" ]] || { echo "Missing $CONFIG" >&2; exit 2; }
# shellcheck source=/dev/null
source "$CONFIG"
: "${REMOTE_HOST:?Set REMOTE_HOST in dev/remote.env}"

[[ $# -eq 1 ]] || { echo "Usage: $0 <job-id>" >&2; exit 2; }
JOB_ID="$1"
[[ "$JOB_ID" =~ ^[0-9]+([_.][0-9]+)?$ ]] || { echo "Invalid job id: $JOB_ID" >&2; exit 2; }
printf -v Q_JOB_ID '%q' "$JOB_ID"

ACTIVE="$(ssh "$REMOTE_HOST" "squeue -h -j$Q_JOB_ID -o '%i|%j|%T|%M|%S|%V|%R' 2>/dev/null || true")"
if [[ -n "$ACTIVE" ]]; then
  echo "Job is active in squeue:"
  echo "JOBID|NAME|STATE|ELAPSED|START|SUBMIT|NODELIST(REASON)"
  echo "$ACTIVE"
  exit 0
fi

ACCOUNTING="$(ssh "$REMOTE_HOST" "sacct -X -j $Q_JOB_ID -P -n --format=JobID,JobName,State,ExitCode,Elapsed,Submit,Start,End,Partition,AllocCPUS,ReqMem,NodeList 2>/dev/null || true")"
if [[ -n "$ACCOUNTING" ]]; then
  echo "Job is not active in squeue; accounting record:"
  echo "JOBID|NAME|STATE|EXITCODE|ELAPSED|SUBMIT|START|END|PARTITION|ALLOCCPUS|REQMEM|NODELIST"
  echo "$ACCOUNTING"
else
  echo "No squeue/sacct record found; trying scontrol:" >&2
  ssh "$REMOTE_HOST" "scontrol show job $Q_JOB_ID"
fi
