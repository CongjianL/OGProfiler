#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
CONFIG="$SCRIPT_DIR/remote.env"
[[ -f "$CONFIG" ]] || { echo "Missing $CONFIG" >&2; exit 2; }
# shellcheck source=/dev/null
source "$CONFIG"

: "${REMOTE_HOST:?Set REMOTE_HOST in dev/remote.env}"
: "${REMOTE_DIR:?Set REMOTE_DIR in dev/remote.env}"

if [[ $# -gt 0 ]]; then
  CMD="$*"
else
  CMD="${REMOTE_TEST_CMD:-pytest -q}"
fi

"$SCRIPT_DIR/push"

printf -v Q_REMOTE_DIR '%q' "$REMOTE_DIR"
printf -v Q_CMD '%q' "$CMD"

if [[ -n "${REMOTE_CONDA:-}" && -n "${REMOTE_CONDA_ENV:-}" ]]; then
  printf -v Q_CONDA '%q' "$REMOTE_CONDA"
  printf -v Q_ENV '%q' "$REMOTE_CONDA_ENV"
  REMOTE_COMMAND="cd $Q_REMOTE_DIR && $Q_CONDA run -n $Q_ENV bash -lc $Q_CMD"
else
  REMOTE_COMMAND="cd $Q_REMOTE_DIR && bash -lc $Q_CMD"
fi

echo "==> Remote test on $REMOTE_HOST"
ssh "$REMOTE_HOST" "$REMOTE_COMMAND"
